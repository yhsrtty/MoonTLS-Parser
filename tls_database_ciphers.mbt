///|
pub fn lookup_cipher_details(id : UInt16) -> CipherDetails? {
  for entry in cipher_details_db {
    if entry.id == id {
      return Some(entry)
    }
  }
  None
}

///|
pub fn cipher_details_db_size() -> Int {
  cipher_details_db.length()
}
